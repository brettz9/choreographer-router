{
  "compilerOptions": {
    "lib": ["esnext", "DOM"],
    "moduleResolution": "nodenext",
    "module": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2024",
    "types": ["cypress"]
  },
  "include": ["src/**/*.js", "cypress/**/*.js"],
  "exclude": ["node_modules"]
}
